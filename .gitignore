/rust/verification/**/*.json.gz
/rust/verification/**/*.jsonl
/rust/verification/**/*.jsonl.gz
/decisions/evidence/**/*.json
/decisions/evidence/**/*.json.gz
/decisions/evidence/**/*.jsonl
/decisions/evidence/**/*.jsonl.gz

